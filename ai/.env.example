APP_NAME=PAWCAST Sentiment AI
APP_VERSION=1.0.0
DEBUG=False
MODEL_NAME=pawcast-review-sentiment-v1
MODEL_PATH=./models/trained_model.pkl
MAX_LENGTH=1000

DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/pawcast
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

JWT_SECRET=replace-with-the-same-spring-secret
JWT_ISSUER=pawcast
INTERNAL_API_KEY=replace-with-a-long-random-internal-secret

INVENTORY_FORECAST_LOOKBACK_DAYS=28
INVENTORY_FORECAST_LEAD_DAYS=7
INVENTORY_FORECAST_SAFETY_DAYS=14


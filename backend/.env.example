# 이 파일을 복사해 .env로 이름을 바꾼 뒤 실제 값을 채웁니다.
# .env는 .gitignore 대상이므로 저장소에 커밋하지 않습니다.

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5432/pawcast
DB_USERNAME=postgres
DB_PASSWORD=

# JWT: 32바이트 이상인 무작위 문자열을 팀에서 하나 발급해 공통 사용합니다.
JWT_SECRET=
JWT_ISSUER=pawcast

# Toss Payments 개발자센터에서 발급한 테스트 키
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# Google Cloud Console OAuth 2.0 웹 클라이언트 ID
GOOGLE_CLIENT_ID=

# FastAPI AI 서버 주소. 같은 PC에서 실행하면 기본값은 http://localhost:8000 입니다.
AI_BASE_URL=http://localhost:8000

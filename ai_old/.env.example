APP_NAME=포캐스트 한국어 리뷰 감정 분석기
DEBUG=True
MODEL_PATH=./models/review/sentiment_model
MODEL_NAME=pawcast-korean-review-sentiment
MAX_LENGTH=256

# PostgreSQL (replace the example credentials locally)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/pawcast
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Spring의 AI_INTERNAL_API_KEY와 반드시 같은 값을 사용합니다.
INTERNAL_API_KEY=replace-with-a-shared-internal-api-key

# Spring Boot의 JWT_SECRET·JWT_ISSUER와 반드시 같은 값을 사용합니다.
JWT_SECRET=replace-with-the-same-32-byte-spring-secret
JWT_ISSUER=pawcast

USE_MOCK_DATA=false
MOCK_RANDOM_SEED=20261119
MOCK_SALES_MONTHS=18
RETRAINING_ORDER_THRESHOLD=100
RETRAINING_MINIMUM_DAYS=7
